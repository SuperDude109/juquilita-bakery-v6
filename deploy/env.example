# Juquilita Bakery v6 production environment example
JB_ENV=production
JB_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JB_TOKEN_PEPPER=replace-with-a-different-long-random-secret-at-least-32-chars
JB_PUBLIC_BASE_URL=https://order.example.com
JB_SECURE_COOKIES=1
JB_ASSUME_HTTPS=1
JB_PAYMENT_PROVIDER=stripe

# First production database initialization only. Remove from the runtime
# environment after python3 server.py --init-db succeeds.
JB_ADMIN_EMAIL=owner@example.com
JB_ADMIN_PASSWORD=replace-with-a-strong-temporary-owner-password
JB_ADMIN_NAME=Bakery Owner
JB_ADMIN_PHONE=+14233079003

# Stripe option
STRIPE_SECRET_KEY=sk_live_value
STRIPE_WEBHOOK_SECRET=whsec_live_value

# Square option
SQUARE_ACCESS_TOKEN=EAAA...
SQUARE_LOCATION_ID=LOCATION_ID
SQUARE_ENV=production
SQUARE_VERSION=2026-05-20
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-with-square-signature-key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://order.example.com/api/webhooks/square

# Email
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=orders@example.com
SENDGRID_FROM_NAME=Juquilita Bakery

# SMS
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_PHONE=+14233079003

# Monitoring
JB_MONITORING_EMAIL=owner@example.com
SENTRY_DSN=
